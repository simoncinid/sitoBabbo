GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_RECIPIENT=simonciniliquiplast@gmail.com

ADMIN_USER=
ADMIN_PASSWORD=

# Blob storage (Vercel): collega lo store al progetto.
# Per l'upload dall'admin serve BLOB_READ_WRITE_TOKEN (creato automaticamente al collegamento).
# BLOB_STORE_ID e BLOB_WEBHOOK_PUBLIC_KEY vengono aggiunti insieme allo store.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# Consigliato per PostgreSQL. Se presente ha precedenza sulle variabili DB_*.
DATABASE_URL=

DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=
DB_SSL=true
DB_USER=
TLS_CERT=

# Facoltativo: utile solo se il database usa una porta non standard.
# Valori supportati: postgres, mysql
DB_DIALECT=
