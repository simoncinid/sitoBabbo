GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_RECIPIENT=simonciniliquiplast@gmail.com

ADMIN_USER=
ADMIN_PASSWORD=

# Blob storage (Vercel): collega lo store al progetto.
# Su Vercel l'SDK usa OIDC + BLOB_STORE_ID; in locale puoi usare BLOB_READ_WRITE_TOKEN.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
BLOB_READ_WRITE_TOKEN=

# Consigliato per PostgreSQL. Se presente ha precedenza sulle variabili DB_*.
DATABASE_URL=

DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=
DB_SSL=true
DB_USER=
TLS_CERT=

# Facoltativo: utile solo se il database usa una porta non standard.
# Valori supportati: postgres, mysql
DB_DIALECT=
