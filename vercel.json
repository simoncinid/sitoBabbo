{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/send-email",
      "destination": "/api/send-email.js"
    },
    {
      "source": "/api/articles",
      "destination": "/api/articles.js"
    },
    {
      "source": "/api/admin/session",
      "destination": "/api/admin/session.js"
    },
    {
      "source": "/api/admin/articles",
      "destination": "/api/admin/articles.js"
    },
    {
      "source": "/api/admin/upload",
      "destination": "/api/admin/upload.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
